# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/webhook

# Role-based access. Owner sees /pnl, /fraud, setcost, link. Employees can
# upload PDFs/settlement files and use /today, /claims, /help only.
OWNER_CHAT_IDS=111111111
EMPLOYEE_CHAT_IDS=222222222,333333333

# Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the private key from your service account JSON. Keep the \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# OCR.space fallback (used only when a PDF page has no extractable text layer,
# e.g. a scanned page). Get a free key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your-ocr-space-api-key

# Server
PORT=3000
# Your deployed Render URL (no trailing slash) - used to build the camera
# scanner WebApp button link, e.g. https://mjm-meesho-bot.onrender.com
PUBLIC_BASE_URL=https://your-app.onrender.com