{
  "manifest_version": 3,
  "name": "MJM Meesho Sync Engine",
  "version": "1.1.0",
  "description": "Auto-sync Meesho orders, returns, and payments to MJM Telegram & Sheets ecosystem",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://supplier.meesho.com/*",
    "https://mjm-meesho-bot.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://supplier.meesho.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}